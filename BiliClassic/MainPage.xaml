<phone:PhoneApplicationPage 
    x:Class="BiliClassic.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="696"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
    shell:SystemTray.IsVisible="True">

    <!-- 页面转场动画 -->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <!--LayoutRoot是包含所有页面内容的根网格-->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="12,17,0,0">
            <TextBlock x:Name="ApplicationTitle" Text="哔哩经典"
                       Style="{StaticResource PhoneTextNormalStyle}"/>
        </StackPanel>

        <!-- Pivot -->
        <controls:Pivot x:Name="HomePivot" Grid.Row="1"
                        SelectionChanged="HomePivot_SelectionChanged">

            <controls:PivotItem Header="推荐">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,0,12,0">
                        <ListBox x:Name="RecommendList" SelectionChanged="RecommendList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 卡片模板 -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="112" Height="70"
                                                Margin="0,0,12,0" Background="#22FFFFFF"
                                                BorderBrush="{StaticResource PhoneSubtleBrush}"
                                                BorderThickness="2">
                                            <!-- 封面 -->
                                            <Grid>
                                                <Image Stretch="UniformToFill"
                                                       Source="/Res/bili_default_image_tv_with_bg.png"/>
                                                <Image Stretch="UniformToFill" Source="{Binding Cover}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <!-- 标题截断 -->
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                       MaxHeight="50"
                                                       Style="{StaticResource PhoneTextNormalStyle}"/>
                                            <TextBlock Text="{Binding InfoLine}"
                                                       Style="{StaticResource PhoneTextSubtleStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!--状态提示与"加载更多"-->
                    <StackPanel Grid.Row="1" Margin="12,4,12,8">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text=""
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                        <Button x:Name="MoreButton" Content="加载更多"
                                Visibility="Collapsed" Click="MoreButton_Click"/>
                    </StackPanel>
                </Grid>
            </controls:PivotItem>

            <controls:PivotItem Header="我的">
                <ScrollViewer>
                    <StackPanel Margin="12,0,12,0">

                        <!-- 名片 -->
                        <Grid Margin="0,4,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 头像 -->
                            <Border Grid.Column="0" Width="88" Height="88"
                                    Background="#22FFFFFF"
                                    BorderBrush="{StaticResource PhoneSubtleBrush}"
                                    BorderThickness="3">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,88,88"/>
                                </Border.Clip>
                                <Grid Width="82" Height="82">
                                    <!-- 显示默认头像 -->
                                    <Image Stretch="UniformToFill"
                                           Source="/Res/bili_default_avatar.png"/>
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="MineName" Text="未登录"
                                           Style="{StaticResource PhoneTextTitle3Style}"/>
                                <TextBlock x:Name="MineLevel" Text=""
                                           Style="{StaticResource PhoneTextSubtleStyle}"/>
                                <TextBlock x:Name="MineSign" Text="" TextWrapping="Wrap"
                                           MaxHeight="60"
                                           Style="{StaticResource PhoneTextSubtleStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="关注的人" Click="FollowingButton_Click"/>
                        <Button Content="播放历史" Click="HistoryButton_Click"/>
                        <Button Content="我的收藏" Click="FavoriteButton_Click"/>

                        <TextBlock x:Name="MineStatus" Text="" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>

        </controls:Pivot>
    </Grid>
 
    <!--底部应用栏-->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton IconUri="/Res/appbar.chevron.left.png"
                                            Text="推荐"
                                            Click="PrevPage_Click"/>
            <shell:ApplicationBarIconButton IconUri="/Res/appbar.chevron.right.png"
                                            Text="我的"
                                            Click="NextPage_Click"/>
            <shell:ApplicationBarIconButton IconUri="/Res/appbar.magnify.png"
                                            Text="搜索"
                                            Click="SearchBarButton_Click"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="刷新" Click="RefreshMenuItem_Click"/>
                <shell:ApplicationBarMenuItem Text="登录" Click="LoginMenuItem_Click"/>
                <shell:ApplicationBarMenuItem Text="设置" Click="SettingsMenuItem_Click"/>
                <shell:ApplicationBarMenuItem Text="关于" Click="AboutMenuItem_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>
