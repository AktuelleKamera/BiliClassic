    <!-- 应用名称多语言资源，由 AppResLib\build.bat (rc.exe + link.exe) 生成。
         Condition 保证在文件尚未生成时工程依然能正常编译。
         生成后 WMAppManifest.xml 需改为 Title="@AppResLib.dll,-100"。 -->
    <Content Include="AppResLib.dll" Condition="Exists('AppResLib.dll')" />
    <Content Include="AppResLib.dll.0804.mui" Condition="Exists('AppResLib.dll.0804.mui')" />
