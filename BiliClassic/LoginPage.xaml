<phone:PhoneApplicationPage
    x:Class="BiliClassic.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="768"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    shell:SystemTray.IsVisible="True">

    <!-- 页面转场动画 -->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <!-- Pivot -->
    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:Pivot x:Name="LoginPivot" Grid.Row="0" Title="登录"
                        SelectionChanged="LoginPivot_SelectionChanged">

            <!-- ==================== 验证码 ==================== -->
            <controls:PivotItem Header="验证码">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="手机号" Margin="0,0,0,6"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                        <TextBox x:Name="TelBox" Height="72"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodeBox" Grid.Column="0" Height="72"/>
                            <Button x:Name="SendButton" Grid.Column="1" Content="发送验证码"
                                    Margin="8,0,0,0" Click="SendButton_Click"/>
                        </Grid>

                        <Button x:Name="SmsLoginButton" Content="登录" Click="SmsLoginButton_Click"/>

                        <TextBlock Text="验证码将会以短信发送到上面的号码。若一直收不到，请改用二维码登录，或在信息页手动登录~"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>

            <!-- 扫码 -->
            <controls:PivotItem Header="扫码">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,24">
                        <Border x:Name="QrFrame" Background="White" Padding="6"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                            <Image x:Name="QrImage"/>
                        </Border>

                        <Button x:Name="RefreshButton" Content="刷新二维码"
                                Margin="0,12,0,0" Click="RefreshButton_Click"/>

                        <TextBlock Text="用B站官方客户端扫码，然后在手机上确认登录~"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>

            <!-- 信息 -->
            <controls:PivotItem Header="信息">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="当前登录状态" Margin="12,0,0,0"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                        <TextBlock x:Name="AccountText" Text="未登录" TextWrapping="Wrap"
                                   Margin="12,6,0,0"
                                   Style="{StaticResource PhoneTextNormalStyle}"/>

                        <TextBlock Text="手动粘贴 Cookie（哔哩经典安卓客户端可导出）"
                                   Margin="12,28,0,6" TextWrapping="Wrap"
                                   Style="{StaticResource PhoneTextSubtleStyle}"/>
                        <TextBox x:Name="CookieBox" Height="72"/>
                        <Button x:Name="CookieButton" Content="使用 Cookie 登录"
                                Click="CookieButton_Click"/>

                        <Button x:Name="LogoutButton" Content="退出登录"
                                Margin="0,12,0,0" Click="LogoutButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>
        </controls:Pivot>

        <!-- 固定状态栏 -->
        <Border Grid.Row="1" Background="#33FFFFFF" Padding="12,10">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Text="就绪"
                       Style="{StaticResource PhoneTextSubtleStyle}"/>
        </Border>
    </Grid>

</phone:PhoneApplicationPage>
