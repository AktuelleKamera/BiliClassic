<phone:PhoneApplicationPage
    x:Class="BiliClassic.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Landscape"
    shell:SystemTray.IsVisible="False" Orientation="Landscape">
	<phone:PhoneApplicationPage.Resources>
		<Storyboard x:Name="ShowBars">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="ControlPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="204">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="grid">
				<EasingDoubleKeyFrame KeyTime="0" Value="-120">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="HideBars">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="ControlPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="202.5">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="grid">
				<EasingDoubleKeyFrame KeyTime="0" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-120">
					<EasingDoubleKeyFrame.EasingFunction>
						<CubicEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="ShowQBars">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" Storyboard.TargetName="QualityPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuarticEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="QualityPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="434"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="HideQBars">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" Storyboard.TargetName="QualityPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="QualityPanel">
				<EasingDoubleKeyFrame KeyTime="0" Value="0"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="444.497"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="ShowVBar">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="grid2">
				<EasingDoubleKeyFrame KeyTime="0" Value="318">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuarticEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuarticEase EasingMode="EaseOut"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="HideVBar">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" Storyboard.TargetName="grid2">
				<EasingDoubleKeyFrame KeyTime="0" Value="3">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuinticEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="3">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuinticEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="grid2">
				<EasingDoubleKeyFrame KeyTime="0" Value="0">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuinticEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
				<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="318">
					<EasingDoubleKeyFrame.EasingFunction>
						<QuinticEase EasingMode="EaseIn"/>
					</EasingDoubleKeyFrame.EasingFunction>
				</EasingDoubleKeyFrame>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
	</phone:PhoneApplicationPage.Resources>

    <!-- 转场 -->
    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <!-- 黑底 -->
    <Grid x:Name="LayoutRoot" Background="Black">
        <!-- DASH音频轨：和视频轨配成一对播，放视频的那条在它上面 -->
        <MediaElement x:Name="AudioPlayer" Stretch="Uniform" AutoPlay="False"
                      MediaOpened="AudioPlayer_MediaOpened"
                      MediaFailed="AudioPlayer_MediaFailed"/>

        <MediaElement x:Name="Player" Stretch="Uniform" AutoPlay="False"
                      MediaOpened="Player_MediaOpened"
                      MediaFailed="Player_MediaFailed"
                      CurrentStateChanged="Player_CurrentStateChanged" MediaEnded="Player_MediaEnded" />

        <!-- 弹幕层 -->
        <Canvas x:Name="DanmakuLayer" IsHitTestVisible="False"/>

        <!-- 透明层 点击 -->
        <Grid x:Name="TapLayer" Background="Transparent"
              MouseLeftButtonUp="TapLayer_MouseLeftButtonUp"/>

        <!-- 顶层 -->
        <Grid x:Name="grid" Height="90" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
        	<Grid.RenderTransform>
        		<CompositeTransform/>
        	</Grid.RenderTransform>
            <Rectangle Height="90" HorizontalAlignment="Left" Name="rectangle1" Stroke="{x:Null}" StrokeThickness="1" VerticalAlignment="Top" Width="800" Fill="#CC000000" />
            <TextBlock x:Name="TitleText" VerticalAlignment="Top" Margin="12,12,13,0"
                   Foreground="White" TextWrapping="Wrap" MaxHeight="50" RenderTransformOrigin="0.5,0.5" Text="" Width="775">
        	<TextBlock.RenderTransform>
        		<CompositeTransform/>
        	</TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
        
        <!-- 底部 -->
        <StackPanel x:Name="stackPanel" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
        	<StackPanel.RenderTransform>
        		<CompositeTransform/>
        	</StackPanel.RenderTransform>
            <Grid Height="111" Name="grid1" Width="800" HorizontalAlignment="Left" VerticalAlignment="Bottom">

                <!-- 清晰度选单：点右下角按钮才展开 -->
                <Border x:Name="QualityPanel" HorizontalAlignment="Right" Background="#CC000000" Padding="8,6" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel x:Name="QualityList" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <CompositeTransform />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Border>
                <!-- 音量条 -->
                <Grid HorizontalAlignment="Left" Margin="540,0,0,0" Name="grid2" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                	<Grid.RenderTransform>
                		<CompositeTransform/>
                	</Grid.RenderTransform>
                    <Rectangle Height="106" HorizontalAlignment="Left" Margin="0" Name="rectangle4" Stroke="{x:Null}" StrokeThickness="1" VerticalAlignment="Top" Width="48" Fill="#CC000000" />
                    <Slider Height="106" HorizontalAlignment="Left" Margin="0" Name="slider1" VerticalAlignment="Bottom" Width="48" Orientation="Vertical" ValueChanged="slider1_ValueChanged" Value="0" />
                </Grid>
            </Grid>
            <!-- 播放控制条 -->
            <Border x:Name="ControlPanel" Background="#CC000000" Padding="12,4" RenderTransformOrigin="0.5,0.5">
            	<Border.RenderTransform>
            		<CompositeTransform/>
            	</Border.RenderTransform>
                <StackPanel>
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="1" Value="0"
                            ValueChanged="SeekBar_ValueChanged"/>
                    <!-- 负上边距盖掉Slider模板自带的空白 -->
                    <Grid Margin="0,-28,0,0">
                        <!-- 图标用白色蒙版，原图的颜色不影响 -->
                        <Button x:Name="PlayPauseButton" MinWidth="0" Padding="8,4"
                                Background="Transparent" BorderThickness="0"
                                Click="PlayPauseButton_Click" Margin="0,0,694,0" Width="80">
                            <Rectangle Width="40" Height="40" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush x:Name="PlayPauseMask"
                                                ImageSource="/Res/Icon/play.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <TextBlock x:Name="PositionText" Foreground="White" VerticalAlignment="Center"
                                   TextAlignment="Left" Text="00:00 / --:--" Margin="80,22,0,22" Width="142" HorizontalAlignment="Left" />
                        <!-- 实际走的是哪条路，开播前为空 -->
                        <Button x:Name="DanmakuButton" MinWidth="0" Padding="8,4"
                                Background="Transparent" BorderThickness="0"
                                Click="DanmakuButton_Click" Margin="0,0,100,0" BorderBrush="{x:Null}" Foreground="{x:Null}" HorizontalAlignment="Right" Width="80">
                            <Rectangle x:Name="DanmakuIcon" Width="40" Height="40" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush x:Name="DanmakuMask" ImageSource="/BiliClassic;component/Res/Icon/danmuon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <!-- 右下角：点开清晰度选单 -->
                        <Button x:Name="QualityButton" Content="720P"
                                MinWidth="0" Padding="12,2"
                                Click="QualityButton_Click" BorderBrush="Transparent" FontSize="20" Foreground="White" HorizontalAlignment="Right" Width="100" />
                        <Button Background="Transparent" BorderThickness="0" MinWidth="0" Name="SoundButton" Padding="8,4" HorizontalAlignment="Right" Width="80" Margin="0,0,180,0" BorderBrush="{x:Null}" Foreground="{x:Null}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="SoundButton_Click">
                            <Rectangle Fill="White" Height="40" Name="rectangle2" Width="40">
                                <Rectangle.OpacityMask>
                                    <ImageBrush x:Name="YinLiangMask" ImageSource="/BiliClassic;component/Res/Icon/sound3.png" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0,0,260,0" MinWidth="0" Name="button2" Padding="8,4" Width="80" BorderBrush="{x:Null}" Foreground="{x:Null}" Visibility="Collapsed">
                            <Rectangle Fill="White" Height="40" Name="rectangle3" Width="40">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="Res/Icon/setting_l.png" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Button>
                        <TextBlock x:Name="TransportText" Text="MP4" Foreground="White" VerticalAlignment="Center" FontSize="20" Margin="235,25,0,25" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="StatusPanel" Background="#99000000" Padding="12,8">
                <TextBlock x:Name="StatusText" Foreground="White" TextWrapping="Wrap"
                           Text="正在获取视频信息…"/>
            </Border>
        </StackPanel>

        <!-- 仿安卓版小电视动画~ -->
        <Grid x:Name="LoadingPanel" Background="#FFBABABA" Visibility="Collapsed">
            <Image x:Name="LoadingTv" Width="120" Height="120"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="LoadingText" Margin="12,0,12,20"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Foreground="#FF616161" FontSize="18"
                       Text="正在获取视频信息…"/>
        </Grid>
    </Grid>

</phone:PhoneApplicationPage>
