# ReSharper / VS 2015+
_ReSharper*/
.vs/

# AppResLib 的两个产物直接入库：生成用的 AppResLib\build.bat 和 .rc 已不在
# （WMAppManifest 里 Title="@AppResLib.dll,-100" 依赖它们，缺了应用名就废了）
# 所以 AppResLib.dll / AppResLib.dll.0804.mui 不在忽略之列
# 编译中间产物仍然忽略
BiliClassic/AppResLib/*.res

# 构建输出（上面已按目录名忽略，这里再按项目路径兜一层）
BiliClassic/Bin/
BiliClassic/obj/
[Bb]uild/
[Ll]ogs/
[Tt]est[Rr]esult*/

# 例外：这个 Build 是 WP7 构建配置（WP7Sdk.targets），不是产物
!BiliClassic/Build/
!BiliClassic/Build/**

# NuGet
packages/
*.nupkg

