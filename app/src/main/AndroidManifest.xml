            android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".HistoryActivityLandscape"
            android:targetActivity=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".HistoryActivitySensor"
            android:targetActivity=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- 注册 FollowingListActivity（关注的人） -->
        <activity
