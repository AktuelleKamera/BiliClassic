        <!-- 注册 SettingsActivity -->
        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 解码设置 -->
        <activity
            android:name=".subsettings.DecoderSettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 OfflineActivity -->
        <activity
            android:name=".OfflineActivity"
            android:screenOrientation="unspecified" />

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".FavoriteVideoListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 FavoriteFolderActivity -->
        <activity
            android:name=".FavoriteFolderListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 PlayerAnimActivity -->
        <activity
            android:name=".player.PlayerAnimActivity"
            android:hardwareAccelerated="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize"
            android:theme="@style/PlayerTheme" />

        <!-- 公告音频播放页 -->
        <activity
            android:name=".player.AudioPlayerActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PartitionDetailActivity"
            android:screenOrientation="behind"
            android:configChanges="screenSize|orientation|keyboardHidden" />

        <activity
            android:name=".metro.MetroSetupActivity"
            android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".metro.MetroSetupActivityLandscape"
            android:exported="false"
            android:screenOrientation="landscape"
            android:targetActivity=".metro.MetroSetupActivity" />

        <activity-alias
            android:name=".metro.MetroSetupActivitySensor"
            android:exported="false"
            android:screenOrientation="sensor"
            android:targetActivity=".metro.MetroSetupActivity" />

        <activity
            android:name=".metro.MetroHomeActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".player.BiliPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/PlayerTheme" />

        <!-- 视频下载后台服务 -->
        <service
            android:name=".download.VideoDownloadService"
            android:exported="false" />

        <!-- 更新检查后台服务 -->
        <service
            android:name=".util.UpdateCheckService"
            android:exported="false" />

        <!-- 外部播放器在线播放本地代理持有服务 -->
        <service
            android:name=".ProxyStreamService"
            android:exported="false" />

        <!-- 桌面搜索小工具 -->
        <receiver
            android:name=".widget.SearchWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>

        <!-- FileProvider -->
        <provider
            android:name=".util.FileProviderCompat"
            android:authorities="tv.biliclassic.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

