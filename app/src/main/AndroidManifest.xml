<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.biliclassic"
    android:installLocation="auto">

    <!-- 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_DOWNLOAD_MANAGER" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".BiliApplication"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >

        <activity
            android:name=".BaseActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".CrashReportActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ImageViewerActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DynamicDetailActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReplyListActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PartitionDetailActivity"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".metro.MetroSetupActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".KeyBindingSetupActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WebViewActivity"
            android:screenOrientation="portrait" />

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:screenOrientation="portrait" />

        <!-- 生放送（直播） -->
        <activity
            android:name=".LiveRoomListActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LiveInfoActivity"
            android:screenOrientation="portrait" />

        <!-- AboutActivity -->
        <activity
            android:name=".AboutActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:screenOrientation="portrait" />

        <activity
            android:name=".VideoDetailActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DeviceInfoActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".UserProfileActivity"
            android:screenOrientation="portrait"/>

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 FollowingListActivity（关注的人） -->
        <activity
            android:name=".FollowingListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 SettingsActivity -->
        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 解码设置 -->
        <activity
            android:name=".subsettings.DecoderSettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 OfflineActivity -->
        <activity
            android:name=".OfflineActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".FavoriteVideoListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 FavoriteFolderActivity -->
        <activity
            android:name=".FavoriteFolderListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 PlayerAnimActivity -->
        <activity
            android:name=".player.PlayerAnimActivity"
            android:hardwareAccelerated="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize"
            android:theme="@style/PlayerTheme" />

        <!-- 简易在线播放器（Ostwind，兼容 Android 2.2 及以下，MediaPlayer + 本地代理） -->
        <activity
            android:name=".player.OstwindPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape"
            android:theme="@style/PlayerTheme" />

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".SpecialLoginActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".metro.MetroHomeActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".player.BiliPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/PlayerTheme" />

        <!-- 视频下载后台服务 -->
        <service
            android:name=".download.VideoDownloadService"
            android:exported="false" />

        <!-- 更新检查后台服务 -->
        <service
            android:name=".util.UpdateCheckService"
            android:exported="false" />

        <!-- 外部播放器在线播放本地代理持有服务 -->
        <service
            android:name=".ProxyStreamService"
            android:exported="false" />

        <!-- 桌面搜索小工具 -->
        <receiver
            android:name=".widget.SearchWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>

        <!-- FileProvider -->
        <provider
            android:name=".util.FileProviderCompat"
            android:authorities="tv.biliclassic.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>