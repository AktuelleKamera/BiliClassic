<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.biliclassic"
    android:installLocation="auto">

    <!-- 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_DOWNLOAD_MANAGER" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".BiliApplication"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >

        <activity
            android:name=".BaseActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".CropActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CrashReportActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ImageViewerActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DynamicDetailActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReplyListActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ArticleActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HelpListActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LiveRoomListActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".KeyBindingSetupActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WebViewActivity"
            android:screenOrientation="unspecified" />

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity-alias
            android:name=".MainLauncherPortrait"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainLauncherLandscape"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainLauncherSensor"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:screenOrientation="sensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLandscape"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />


        <activity-alias
            android:name=".MainActivitySensor"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- 外部链接分发 -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="bilibili.com" />
                <data android:host="*.bilibili.com" />
                <data android:host="b23.tv" />
                <data android:host="*.b23.tv" />
                <data android:host="b23.com" />
                <data android:host="*.b23.com" />
                <data android:host="bili2233.cn" />
                <data android:host="*.bili2233.cn" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bilibili" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SearchActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".LiveInfoActivity"
            android:screenOrientation="portrait" />

        <!-- AboutActivity -->
        <activity
            android:name=".AboutActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:screenOrientation="portrait" />

        <!-- 彩蛋：星战字幕 -->
        <activity
            android:name=".EasterEggActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:hardwareAccelerated="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection" />

        <activity
            android:name=".VideoDetailActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".nfc.NfcSyncActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="biliclassic" android:host="sync" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeviceInfoActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".UserProfileActivity"
            android:screenOrientation="portrait"/>

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".HistoryActivityLandscape"
            android:targetActivity=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".HistoryActivitySensor"
            android:targetActivity=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <!-- 注册 FollowingListActivity（关注的人） -->
        <activity
            android:name=".FollowingListActivity"
            android:screenOrientation="portrait" />

        <!-- 私信会话列表 -->
        <activity
            android:name=".PrivateMsgListActivity"
            android:screenOrientation="portrait" />

        <!-- 私信聊天 -->
        <activity
            android:name=".PrivateMsgActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />

        <!-- 注册 SettingsActivity -->
        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 解码设置 -->
        <activity
            android:name=".subsettings.DecoderSettingsActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 OfflineActivity -->
        <activity
            android:name=".OfflineActivity"
            android:screenOrientation="unspecified" />

        <!-- 注册 LoginActivity -->
        <activity
            android:name=".FavoriteVideoListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 FavoriteFolderActivity -->
        <activity
            android:name=".FavoriteFolderListActivity"
            android:screenOrientation="portrait" />

        <!-- 注册 PlayerAnimActivity -->
        <activity
            android:name=".player.PlayerAnimActivity"
            android:hardwareAccelerated="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize"
            android:theme="@style/PlayerTheme" />

        <!-- 公告音频播放页 -->
        <activity
            android:name=".player.AudioPlayerActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PartitionDetailActivity"
            android:screenOrientation="behind"
            android:configChanges="screenSize|orientation|keyboardHidden" />

        <activity
            android:name=".metro.MetroSetupActivity"
            android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".metro.MetroSetupActivityLandscape"
            android:exported="false"
            android:screenOrientation="landscape"
            android:targetActivity=".metro.MetroSetupActivity" />

        <activity-alias
            android:name=".metro.MetroSetupActivitySensor"
            android:exported="false"
            android:screenOrientation="sensor"
            android:targetActivity=".metro.MetroSetupActivity" />

        <activity
            android:name=".metro.MetroHomeActivity"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".player.BiliPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/PlayerTheme" />

        <!-- 视频下载后台服务 -->
        <service
            android:name=".download.VideoDownloadService"
            android:exported="false" />

        <!-- 更新检查后台服务 -->
        <service
            android:name=".util.UpdateCheckService"
            android:exported="false" />

        <!-- 外部播放器在线播放本地代理持有服务 -->
        <service
            android:name=".ProxyStreamService"
            android:exported="false" />

        <!-- 桌面搜索小工具 -->
        <receiver
            android:name=".widget.SearchWidgetProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/search_widget_info" />
        </receiver>

        <!-- FileProvider -->
        <provider
            android:name=".util.FileProviderCompat"
            android:authorities="tv.biliclassic.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity-alias
            android:name=".SearchActivityLandscape"
            android:targetActivity=".SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".SearchActivitySensor"
            android:targetActivity=".SearchActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity-alias
            android:name=".VideoDetailActivityLandscape"
            android:targetActivity=".VideoDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".VideoDetailActivitySensor"
            android:targetActivity=".VideoDetailActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity-alias
            android:name=".WebViewActivityLandscape"
            android:targetActivity=".WebViewActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".WebViewActivitySensor"
            android:targetActivity=".WebViewActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity-alias
            android:name=".OfflineActivityLandscape"
            android:targetActivity=".OfflineActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".OfflineActivitySensor"
            android:targetActivity=".OfflineActivity"
            android:exported="false"
            android:screenOrientation="sensor" />

        <activity-alias
            android:name=".metro.MetroHomeActivityLandscape"
            android:targetActivity=".metro.MetroHomeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity-alias
            android:name=".metro.MetroHomeActivitySensor"
            android:targetActivity=".metro.MetroHomeActivity"
            android:exported="false"
            android:screenOrientation="sensor" />
    </application>

</manifest>
