<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/bili_texture_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#33000000</item>
    </style>

    <style name="PlayerTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog</item>
    </style>

    <style name="DialogStyle_Holo" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <style name="DialogStyle_Material" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
</resources>
