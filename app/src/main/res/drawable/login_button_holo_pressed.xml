<?xml version="1.0" encoding="utf-8"?>
<!-- Holo 主题色按钮（按下/选中）：淡粉高光，对齐 1.8.4 pressed 态 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#66FDA3C6" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#E6FCA3C5" />
            <stroke
                android:width="1dp"
                android:color="#FDA3C6" />
        </shape>
    </item>
</layer-list>
