<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_login"
            android:textSize="20sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paste_login_info"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_cookie_help"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/cookie_input"
            style="@style/LoginInput"
            android:textColor="#333333"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:gravity="top|left"
            android:padding="8dp"
            android:hint="@string/paste_cookie"
            android:inputType="textMultiLine"
            android:singleLine="false"
            android:textSize="12sp"
            android:background="@drawable/login_input_holo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cookie_save"
                style="@style/AppWidget.Button.ThemeColor.Large"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/confirm_login" />

            <Button
                android:id="@+id/cookie_clear"
                style="@style/AppWidget.Button.ThemeColor.Large"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/common_clear_data" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
