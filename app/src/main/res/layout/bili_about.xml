                    style="@style/AboutTableText"
                    android:text="@string/bili_about_skyler1n" />
            </TableRow>
            <TableRow></TableRow>
        </TableLayout>

        <!-- 监督区域 -->

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/director"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/AboutBodyText"
                android:text="@string/credit_supervisor" />

            <TextView
                style="@style/AboutBodyText"
                android:text="@string/credit_zhumeng3" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
