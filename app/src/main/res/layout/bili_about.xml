                    android:text="@string/bili_about_mc_windows" />
            </TableRow>
        </TableLayout>

        <!-- 赞助 -->
        <TextView
            android:id="@+id/thanks"
            style="@style/AboutBodyText"
            android:layout_marginTop="12dp"
            android:text="@string/credit_support" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_gunmu" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_klaoyu" />
            </TableRow>
            <TableRow>
                <TextView
