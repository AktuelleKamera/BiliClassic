<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 应用信息卡片 -->
        <LinearLayout
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/app_brief"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_margin="8dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableRow>
                    <TextView
                        style="@style/AboutTableText"
                        android:text="@string/credit_feedback_group" />
                    <TextView
                        style="@style/AboutTableText"
                        android:text="@string/bili_about_qq_group" />
                </TableRow>
                <TableRow>
                    <TextView
                        style="@style/AboutTableText"
                        android:text="@string/bili_about_53cd_1" />
                    <TextView
                        android:id="@+id/release_website"
                        style="@style/AboutTableText" />
                </TableRow>
            </TableLayout>

        </LinearLayout>

        <!-- STAFF 区域 -->
        <TextView
            style="@style/AboutBodyText"
            android:text="@string/bili_about_staff"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="8dp" />

        <TextView
            style="@style/AboutBodyText"
            android:text="@string/credit_original"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/bilibili_website"
            style="@style/AboutBodyText" />

        <TextView
            style="@style/AboutBodyText"
            android:text="@string/credit_planning"
            android:layout_marginTop="12dp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_9bishi" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_maoziqiu" />
            </TableRow>
        </TableLayout>

        <TextView
            android:id="@+id/textView"
            style="@style/AboutBodyText"
            android:layout_marginTop="12dp"
            android:text="@string/credit_production" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_maoziqiu" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_skyler1n" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_wcxawa" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_cctyl" />
            </TableRow>
        </TableLayout>

        <TextView
            style="@style/AboutBodyText"
            android:text="@string/credit_system_design"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tv_system_architect"
            style="@style/AboutBodyText"
            android:text="@string/bili_about_skyler1n" />

        <TextView
            style="@style/AboutBodyText"
            android:text="@string/credit_open_source"
            android:layout_marginTop="12dp" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/wolfSSL/wolfssl" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/bilibili/ijkplayer" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://gitee.com/RobinNotBad/BiliClient" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/bggRGjQaUbCoE/PiliPlus" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/luern0313/WristBilibili" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/bilibili/DanmakuFlameMaster" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/qidian55/bilibilitv1.6.6-repair" />

        <TextView
            style="@style/AboutBodyText"
            android:text="https://github.com/bilibili-plugins/bilibili-api-collect" />

        <!-- 特别鸣谢 -->
        <TextView
            style="@style/AboutBodyText"
            android:text="@string/credit_cooperation"
            android:layout_marginTop="12dp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_xiaosuyang" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_zhumeng3" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_liumu" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_cctyl" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_liulang_hunter" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_chuichui" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_wcxawa" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_not_shikieimaru" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_shizhenchan" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_moreixima" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_mongou666" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_biribili_user" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_budong" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_shuiqu" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_steven_rong" />
