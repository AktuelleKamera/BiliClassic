                    style="@style/AboutTableText"
                    android:text="@string/bili_about_liumu" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_liulang_hunter" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_chuichui" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_nullnanerror" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_mongou666" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_biribili_user" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_shuiqu" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_mc_windows" />
                <TextView
                    android:id="@+id/textView4"
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_steven_rong" />
            </TableRow>
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_budong" />
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/credit_shizhenchan" />
            </TableRow>
        </TableLayout>

        <!-- 赞助 -->
        <TextView
            android:id="@+id/thanks"
            style="@style/AboutBodyText"
            android:layout_marginTop="12dp"
            android:text="@string/credit_support" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TableRow>
                <TextView
                    style="@style/AboutTableText"
                    android:text="@string/bili_about_wcxawa" />
