<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <!-- 小返回箭头 -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/common_back"
            android:scaleType="centerInside"
            android:src="@drawable/abs__ic_ab_back_holo_light"
            android:focusable="true"
            android:clickable="true" />

        <!-- 标题：左对齐，带粉色点击特效 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/btn_back"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/titlebar_pink_item_bg"
            android:gravity="center_vertical"
            android:paddingLeft="0dp"
            android:paddingRight="8dp"
            android:maxWidth="240dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/common_login"
            android:textSize="18dp"
            android:textColor="#616161" />

    </RelativeLayout>

    <!-- 粉色分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#FCA3C5" />

    <!-- 登录方式 Tab（古早粉色 TabWidget 风格，与分区页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#D86DA5">

        <TextView
            android:id="@+id/tab_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_qr"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_sms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_sms"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_web"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_web"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_cookie"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/manual_login"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

    </LinearLayout>

    <!-- 内容容器（透出纹理背景） -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
