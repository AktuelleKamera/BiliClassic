<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bili_texture_background">

    <!-- 顶栏 -->
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/common_back_3"
            android:padding="1dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_action_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/common_login"
            android:textSize="18sp"
            android:textColor="#333333"/>

    </RelativeLayout>

    <!-- 粉色分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:background="#FCA3C5" />

    <!-- 登录方式 Tab（古早粉色 TabWidget 风格，与分区页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#D86DA5">

        <TextView
            android:id="@+id/tab_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_qr"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_sms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_sms"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_web"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_web"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

        <TextView
            android:id="@+id/tab_cookie"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp"
            android:text="@string/login_tab_cookie"
            android:textSize="14sp"
            android:background="@drawable/bili_tab_label_bg_selector"
            android:textColor="@drawable/bili_tab_label_text_selector" />

    </LinearLayout>

    <!-- 内容容器（透出纹理背景） -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
