<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Page 1: Welcome -->
    <LinearLayout
        android:id="@+id/page_welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/welcome_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/setup_page_padding">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_setup_521d"
                android:textSize="@dimen/setup_title_text_size"
                android:textColor="#D86DA5" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_divider_height"
            android:background="#D86DA5" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/activity_setup_6b22"
                android:textSize="@dimen/setup_content_text_size"
                android:textColor="#666666" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/welcome_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="right"
            android:padding="@dimen/setup_page_padding"
            android:layout_marginBottom="@dimen/setup_page_padding">

            <TextView
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_setup_4e0b"
                android:textSize="@dimen/setup_button_text_size"
                android:textColor="#D86DA5"
                android:padding="@dimen/setup_button_padding"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Page 2: Tile Selection -->
    <LinearLayout
        android:id="@+id/page_tiles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tiles_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/setup_page_padding">

            <TextView
                android:id="@+id/page2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_setup_9009"
                android:textSize="@dimen/setup_title_text_size"
                android:textColor="#D86DA5" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/setup_divider_height"
            android:background="#D86DA5" />

        <ScrollView
            android:id="@+id/tile_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="@dimen/setup_page_padding"
            android:paddingBottom="@dimen/setup_page_padding"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/tile_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/tiles_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="right"
            android:padding="@dimen/setup_page_padding"
            android:layout_marginBottom="@dimen/setup_page_padding">

            <TextView
                android:id="@+id/btn_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_setup_5f00"
                android:textSize="@dimen/setup_button_text_size"
                android:textColor="#D86DA5"
                android:padding="@dimen/setup_button_padding"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Page 3: 按键绑定（首启有物理按键设备，磁贴页点"开始"后滑入） -->
    <LinearLayout
        android:id="@+id/page_binding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 询问页 -->
        <LinearLayout
            android:id="@+id/page_ask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ask_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/setup_page_padding">

                <TextView
                    android:id="@+id/binding_ask_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keybinding_title"
                    android:textSize="@dimen/setup_title_text_size"
                    android:textColor="#D86DA5" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_divider_height"
                android:background="#D86DA5" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/binding_ask_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingLeft="@dimen/setup_message_padding"
                    android:paddingRight="@dimen/setup_message_padding"
                    android:text="@string/keybinding_ask_message"
                    android:textSize="@dimen/setup_content_text_size"
                    android:textColor="#666666" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/setup_page_padding"
                android:layout_marginBottom="@dimen/setup_page_padding">

                <TextView
                    android:id="@+id/btn_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keybinding_yes"
                    android:textSize="@dimen/setup_button_text_size"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/setup_ask_yes_bg"
                    android:padding="@dimen/setup_button_padding"
                    android:layout_marginRight="@dimen/setup_page_padding"
                    android:clickable="true"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/btn_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keybinding_no"
                    android:textSize="@dimen/setup_button_text_size"
                    android:textColor="#D86DA5"
                    android:background="@drawable/setup_ask_no_bg"
                    android:padding="@dimen/setup_button_padding"
                    android:clickable="true"
                    android:focusable="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- 录制页 -->
        <LinearLayout
            android:id="@+id/page_record"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/record_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/setup_page_padding">

                <TextView
                    android:id="@+id/record_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/keybinding_title"
                    android:textSize="@dimen/setup_title_text_size"
                    android:textColor="#D86DA5" />

                <TextView
                    android:id="@+id/btn_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keybinding_exit"
                    android:textSize="@dimen/setup_button_text_size"
                    android:textColor="#D86DA5"
                    android:background="#FFFFFF"
                    android:padding="@dimen/setup_button_padding"
                    android:clickable="true"
                    android:focusable="false" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/setup_divider_height"
                android:background="#D86DA5" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/prompt_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/keybinding_prompt_prefix"
                    android:textSize="@dimen/setup_prompt_text_size"
                    android:textColor="#333333" />

            </FrameLayout>

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="@dimen/setup_message_padding"
                android:paddingRight="@dimen/setup_message_padding"
                android:textSize="@dimen/setup_progress_text_size"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/record_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="@dimen/setup_message_padding"
                android:paddingRight="@dimen/setup_message_padding"
                android:text="@string/keybinding_recording_hint"
                android:textSize="@dimen/setup_hint_text_size"
                android:textColor="#999999"
                android:paddingBottom="@dimen/setup_button_padding" />

            <TextView
                android:id="@+id/exit_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="@dimen/setup_message_padding"
                android:paddingRight="@dimen/setup_message_padding"
                android:text="@string/keybinding_exit_hint"
                android:textSize="@dimen/setup_hint_text_size"
                android:textColor="#999999"
                android:layout_marginBottom="@dimen/setup_page_padding" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
