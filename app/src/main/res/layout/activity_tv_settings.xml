<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/activity_tv_settings_8bbe"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"
            android:textStyle="normal" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_tv_settings_8fd4"
            android:textSize="16sp"
            android:textColor="#1E90FF"
            android:background="@null"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_threads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_56fe"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_9ed8"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_decoder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_89e3"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_decoder_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_89e3"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_renderer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_89c6"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_danmaku_engine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_5f39"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_89c6"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_home_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_9ed8"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <!-- 横屏适配 -->
            <LinearLayout
                android:id="@+id/landscape_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_6a2a"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_5728"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkbox_landscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false"
                    android:padding="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <!-- 现代模式 -->
            <LinearLayout
                android:id="@+id/modern_mode_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_73b0"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_4f7f"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkbox_modern_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false"
                    android:padding="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <!-- 在线播放 -->
            <LinearLayout
                android:id="@+id/online_play_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_5728"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_5b9e"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkbox_online_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false"
                    android:padding="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <!-- TV模式强制开关 -->
            <LinearLayout
                android:id="@+id/force_tv_mode_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_6a21"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_tv_settings_5f3a"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="normal" />

                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkbox_force_tv_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false"
                    android:padding="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_cookie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_7ba1"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_6e05"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_clear_play_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_6e05"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_crash_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_5d29"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_echo_hole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_56de"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_8bbe"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_dialog_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_5f39"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_68c0"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btn_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|center_vertical"
                android:text="@string/activity_tv_settings_5173"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:textStyle="normal"
                android:background="@drawable/tv_tile_bg"
                android:padding="20dp"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
