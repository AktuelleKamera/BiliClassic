<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 评论式头部：头像 + 昵称/时间 + 正文 -->
    <LinearLayout
        android:id="@+id/dd_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/item_click_effect_white">

        <ImageView
            android:id="@+id/dd_avatar"
            android:layout_width="@dimen/reply_avatar_size"
            android:layout_height="@dimen/reply_avatar_size"
            android:scaleType="centerCrop"
            android:src="@drawable/bili_default_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/reply_avatar_size"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dd_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/dd_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:textColor="#999999"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dd_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#555555"
                android:textSize="@dimen/reply_content_text_size"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- 正文区：图片 / 卡片 / 转发 / 点赞 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/dd_pics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dd_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E8E8E8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/dd_card_cover"
                android:layout_width="96dp"
                android:layout_height="60dp"
                android:background="@drawable/bili_thumb_boarder"
                android:padding="3dp"
                android:cropToPadding="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bili_default_image_tv_with_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dd_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/dd_card_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#999999"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dd_forward_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E8E8E8"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/dd_forward_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dd_like"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#D86DA5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dd_write_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F0F0F0"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="写下你的评论…"
            android:textColor="#999999"
            android:textSize="13sp" />

    </LinearLayout>
</LinearLayout>
