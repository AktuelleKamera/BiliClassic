<?xml version="1.0" encoding="utf-8"?>
<Deployment xmlns="http://schemas.microsoft.com/windowsphone/2014/deployment" AppPlatformVersion="8.1">
  <DefaultLanguage xmlns="" code="zh-CN"/>
  <!-- ProductID 和 WP7 包故意不同，两个包可以同时装在一台机器上 -->
  <!-- Title 暂时写死：WP8 认不认 AppResLib 那套没验证，跑通了再换回 @AppResLib.dll,-100 -->
  <App xmlns="" ProductID="{4C1B9A72-3D5E-4F80-9B21-6E7A0C5D2F18}"
       Title="哔哩经典" RuntimeType="Silverlight"
       Version="0.3.0.0" Genre="apps.normal"
       Author="BiliClassic author" Description="哔哩经典 for WP"
       Publisher="BiliClassic" PublisherID="{9F2E6B14-8A73-4C95-B0D3-1A4E7C6B5D20}">
    <IconPath IsRelative="true" IsResource="false">Res\SmallLogo.scale-240.png</IconPath>
    <Capabilities>
      <!-- 只要联网：定位/麦克风/推送那些一律别声明，Store 审核会问 -->
      <Capability Name="ID_CAP_NETWORKING"/>
      <!-- MediaElement必须有，WP8把media能力拆细了
           少一条就是立刻MediaFailed，不是连不上 -->
      <Capability Name="ID_CAP_MEDIALIB_AUDIO"/>
      <Capability Name="ID_CAP_MEDIALIB_PLAYBACK"/>
    </Capabilities>
    <!-- Tasks 必须排在 Tokens 前面，8.1 的 XSD 是定序的 -->
    <Tasks>
      <DefaultTask Name="_default" NavigationPage="MainPage.xaml"/>
    </Tasks>
    <Tokens>
      <PrimaryToken TokenID="BiliClassicWP8Token" TaskName="_default">
        <TemplateFlip>
          <SmallImageURI IsRelative="true" IsResource="false">Res\Square71x71Logo.scale-240.png</SmallImageURI>
          <Count>0</Count>
          <BackgroundImageURI IsRelative="true" IsResource="false">Res\Logo.scale-240.png</BackgroundImageURI>
          <Title>哔哩经典</Title>
          <BackContent></BackContent>
          <BackBackgroundImageURI></BackBackgroundImageURI>
          <BackTitle></BackTitle>
          <!-- 宽磁贴：图复用 Res 里那张 240% 宽图，比例和 691x336 几乎一致 -->
          <LargeBackgroundImageURI IsRelative="true" IsResource="false">Res\WideLogo.scale-240.png</LargeBackgroundImageURI>
          <LargeBackContent></LargeBackContent>
          <LargeBackBackgroundImageURI></LargeBackBackgroundImageURI>
          <DeviceLockImageURI></DeviceLockImageURI>
          <HasLarge>true</HasLarge>
        </TemplateFlip>
      </PrimaryToken>
    </Tokens>
    <!-- 声明16:9，1080p机器归 HD720P 这一类 -->
    <ScreenResolutions>
      <ScreenResolution Name="ID_RESOLUTION_WVGA"/>
      <ScreenResolution Name="ID_RESOLUTION_WXGA"/>
      <ScreenResolution Name="ID_RESOLUTION_HD720P"/>
    </ScreenResolutions>
  </App>
</Deployment>
